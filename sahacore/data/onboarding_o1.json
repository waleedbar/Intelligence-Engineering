{
  "sheet": "O·O1 Anthropometrics",
  "equations": [
    {
      "equation_id": "O1.1",
      "source_row": 10,
      "name": "Fast compartment volume",
      "formula": "V_f = V_ref * (BW/70)^0.75",
      "variables": "V_ref=15L — GENERIC PRIOR ONLY, not a universal physiological plasma volume. Apparent volume is compound-specific: use per-nutrient V_f,i where characterised (see 098). BW=body weight (kg).  [v39l F-AX]",
      "units": "Liters",
      "value_range": "5-25 L",
      "engine_target": "Layer B (B1): V_f"
    },
    {
      "equation_id": "O1.2",
      "source_row": 11,
      "name": "Slow compartment volume",
      "formula": "V_s = V_s_ref * (BW/70)^0.85",
      "variables": "V_s_ref=30L — GENERIC PRIOR ONLY (see V_ref note). Use per-nutrient V_s,i where characterised. BW=body weight (kg).  [v39l F-AX]",
      "units": "Liters",
      "value_range": "15-50 L",
      "engine_target": "Layer B (B1): V_s"
    },
    {
      "equation_id": "O1.3",
      "source_row": 12,
      "name": "Body Mass Index",
      "formula": "BMI = BW / (height_m)^2",
      "variables": "BW=weight (kg), height_m=height (m)",
      "units": "kg/m2",
      "value_range": "15-50",
      "engine_target": "O1.6, O1.7, O11"
    },
    {
      "equation_id": "O1.4",
      "source_row": 13,
      "name": "Waist-to-Height Ratio",
      "formula": "WHtR = waist_cm / height_cm",
      "variables": "waist_cm=waist circumference, height_cm=height",
      "units": "dimensionless",
      "value_range": "0.3-0.8",
      "engine_target": "O1.5, O11"
    },
    {
      "equation_id": "O1.5",
      "source_row": 14,
      "name": "Insulin Resistance sigmoid",
      "formula": "kappa_IR = 1 / (1 + exp(-k_IR*(WHtR - 0.5)))",
      "variables": "k_IR=5 (sigmoid slope), WHtR from O1.4",
      "units": "dimensionless",
      "value_range": "0-1",
      "engine_target": "Layer C (C2): kappa_IR, O11 (Z6)"
    },
    {
      "equation_id": "O1.6",
      "source_row": 15,
      "name": "Basal Metabolic Rate (Mifflin-St Jeor)",
      "formula": "BMR_male = 10*BW + 6.25*height_cm - 5*age + 5\nBMR_female = 10*BW + 6.25*height_cm - 5*age - 161  [v39l F-DM]",
      "variables": "BW (kg), height_cm, age (years), sex",
      "units": "kcal/day",
      "value_range": "1000-2500",
      "engine_target": "Layer A: energy baseline"
    },
    {
      "equation_id": "O1.7",
      "source_row": 16,
      "name": "CRP multiplier (obesity)",
      "formula": "CRP_mult = 1 + 0.3 * max(BMI - 25, 0)",
      "variables": "BMI from O1.3",
      "units": "dimensionless",
      "value_range": "1.0-8.5",
      "engine_target": "Layer C: inflammation modifier"
    },
    {
      "equation_id": "O1.8",
      "source_row": 17,
      "name": "Unbound fraction",
      "formula": "f_u = f_u_ref * (1 - 0.1 * max(BMI - 25, 0) / 25)",
      "variables": "f_u_ref per nutrient, BMI from O1.3",
      "units": "dimensionless",
      "value_range": "0.01-1.0",
      "engine_target": "Layer B (B2): f_u"
    },
    {
      "equation_id": "O1.9",
      "source_row": 18,
      "name": "Central adiposity composite",
      "formula": "mu_centadip = 0.45*e_waist + 0.30*e_WHtR + 0.20*e_BMI + 0.05*I(neck>40cm)",
      "variables": "e_waist, e_WHtR, e_BMI: normalized [0,1] indices",
      "units": "dimensionless",
      "value_range": "0-1",
      "engine_target": "O11 (Z3, Z6): adiposity_CRP"
    },
    {
      "equation_id": "O1.10",
      "source_row": 19,
      "name": "Waist exposure index",
      "formula": "e_waist = min(1, max(0, (waist - threshold_lo) / (threshold_hi - threshold_lo)))",
      "variables": "Male: threshold_lo=94cm, threshold_hi=102cm\nFemale: threshold_lo=80cm, threshold_hi=88cm",
      "units": "dimensionless",
      "value_range": "0-1",
      "engine_target": "O1.9: e_waist"
    }
  ],
