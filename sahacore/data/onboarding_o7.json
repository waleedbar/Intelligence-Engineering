{
  "sheet": "O·O7 Diet Pattern Priors",
  "equations": [
    {
      "equation_id": "O7.1",
      "source_row": 10,
      "name": "Nutrient prior (per pattern)",
      "formula": "C_f(0)_i ~ N(mu_pattern_i, sigma2_pattern_i)",
      "variables": "mu_pattern_i = expected intake for nutrient i under pattern m",
      "units": "mg or g",
      "value_range": "varies per nutrient",
      "engine_target": "Layer E: x_hat(0)[1..81]"
    },
    {
      "equation_id": "O7.2",
      "source_row": 11,
      "name": "Bayesian posterior update",
      "formula": "sigma2_post = 1 / (1/sigma2_prior + k/sigma2_obs)",
      "variables": "sigma2_prior from pattern, sigma2_obs from food logs, k=days",
      "units": "varies",
      "value_range": "narrows over time",
      "engine_target": "Layer E: P(0) diagonal"
    },
    {
      "equation_id": "O7.3",
      "source_row": 12,
      "name": "Prior dominance period",
      "formula": "Days 1-7: prior dominates (k small)\nDay 14+: food logs dominate (k large)",
      "variables": "k = number of observation days",
      "units": "days",
      "value_range": "1-14+",
      "engine_target": "Transition logic"
    },
    {
      "equation_id": "O7.4",
      "source_row": 13,
      "name": "Diet Quality Index",
      "formula": "DQI = (fruit_serv + veg_serv) / 10",
      "variables": "fruit_serv, veg_serv from Step 3",
      "units": "dimensionless",
      "value_range": "0-1",
      "engine_target": "O11: Z5 Epigenetic Drift"
    }
  ],
